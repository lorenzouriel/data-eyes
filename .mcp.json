{
  "mcpServers": {
    "data-eyes-mcp": {
      "command": "uv",
      "args": [
        "--directory",
        "mcp",
        "run",
        "data-eyes-mcp"
      ],
      "env": {
        "DEPLOYMENT_ENVIRONMENT": "development",
        "INSTANCE_ALLOWLIST": "dev",
        "DEFAULT_PRINCIPAL": "development-agent",
        "MCP_ACCESS_FILE": "../mcp-access.yaml",
        "PROMETHEUS_URL": "http://localhost:9090"
      }
    }
  }
}
