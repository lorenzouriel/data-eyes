{
  "uid": "data-eyes-fleet",
  "title": "Data Eyes / Fleet",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(data_eyes_sqlserver_reachable, environment)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "sql_instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(data_eyes_sqlserver_reachable, sql_instance)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "SQL Server reachability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "data_eyes_sqlserver_reachable{sql_instance=~\"${sql_instance:regex}\",environment=~\"${environment:regex}\"}",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{sql_instance}} {{category}} {{check}} {{file}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Overall health (0 OK, 1 Unknown, 2 Warning, 3 Critical)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "data_eyes_overall_severity{sql_instance=~\"${sql_instance:regex}\",environment=~\"${environment:regex}\"}",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{sql_instance}} {{category}} {{check}} {{file}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green"
                },
                "1": {
                  "text": "Unknown",
                  "color": "gray"
                },
                "2": {
                  "text": "Warning",
                  "color": "orange"
                },
                "3": {
                  "text": "Critical",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Category health",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "data_eyes_health_severity{sql_instance=~\"${sql_instance:regex}\",environment=~\"${environment:regex}\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "{{sql_instance}} {{category}} {{check}} {{file}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green"
                },
                "1": {
                  "text": "Unknown",
                  "color": "gray"
                },
                "2": {
                  "text": "Warning",
                  "color": "orange"
                },
                "3": {
                  "text": "Critical",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "SQL Server CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "data_eyes_sql_cpu_pct{sql_instance=~\"${sql_instance:regex}\",environment=~\"${environment:regex}\"}",
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{sql_instance}} {{category}} {{check}} {{file}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Batch requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "data_eyes:batch_requests_per_second{sql_instance=~\"${sql_instance:regex}\",environment=~\"${environment:regex}\"}",
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{sql_instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Wait seconds / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (sql_instance) (rate(data_eyes_wait_seconds_total{sql_instance=~\"${sql_instance:regex}\",environment=~\"${environment:regex}\"}[5m]))",
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{sql_instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Databases not ONLINE",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (sql_instance) (data_eyes_database_state{sql_instance=~\"${sql_instance:regex}\",environment=~\"${environment:regex}\"} != bool 0)",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{sql_instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      }
    },
    {
      "id": 8,
      "title": "Deadlocks in selected range",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (sql_instance) (increase(data_eyes_deadlocks_total{sql_instance=~\"${sql_instance:regex}\",environment=~\"${environment:regex}\"}[$__range]))",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{sql_instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      }
    },
    {
      "id": 9,
      "title": "Seconds since last successful collection (worst group)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (sql_instance) (time() - data_eyes_collection_last_success_timestamp_seconds{sql_instance=~\"${sql_instance:regex}\",environment=~\"${environment:regex}\"})",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{sql_instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 120
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      }
    }
  ],
  "links": [
    {
      "title": "Fleet",
      "type": "link",
      "url": "/d/data-eyes-fleet",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Instance",
      "type": "link",
      "url": "/d/data-eyes-instance",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Database",
      "type": "link",
      "url": "/d/data-eyes-database",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Health",
      "type": "link",
      "url": "/d/data-eyes-health",
      "keepTime": true,
      "includeVars": true
    }
  ]
}