      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "data_eyes_sql_memory_bytes{sql_instance=~\"${sql_instance:regex}\",environment=~\"${environment:regex}\"}",
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{sql_instance}} {{category}} {{check}} {{file}}"
        }
