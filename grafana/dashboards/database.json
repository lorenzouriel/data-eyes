{
  "uid": "data-eyes-database",
  "title": "Data Eyes / Database",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(data_eyes_sqlserver_reachable, environment)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "sql_instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(data_eyes_sqlserver_reachable, sql_instance)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "database",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(data_eyes_database_size_bytes{sql_instance=~\"${sql_instance:regex}\",environment=~\"${environment:regex}\"}, database)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Database check values (catalog units)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "data_eyes_database_check_value{sql_instance=~\"${sql_instance:regex}\",environment=~\"${environment:regex}\",database=~\"${database:regex}\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "{{sql_instance}} {{category}} {{check}} {{file}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Database check severity",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "data_eyes_database_check_severity{sql_instance=~\"${sql_instance:regex}\",environment=~\"${environment:regex}\",database=~\"${database:regex}\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "{{sql_instance}} {{category}} {{check}} {{file}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green"
                },
                "1": {
                  "text": "Unknown",
                  "color": "gray"
                },
                "2": {
                  "text": "Warning",
                  "color": "orange"
                },
                "3": {
                  "text": "Critical",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Events in selected range (per instance)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(data_eyes_check_events_total{sql_instance=~\"${sql_instance:regex}\",environment=~\"${environment:regex}\"}[$__range])",
          "instant": true,
          "format": "table",
          "legendFormat": "{{sql_instance}} {{category}} {{check}} {{file}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Database state",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "data_eyes_database_state{sql_instance=~\"${sql_instance:regex}\",environment=~\"${environment:regex}\",database=~\"${database:regex}\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "{{sql_instance}} {{category}} {{check}} {{file}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ONLINE",
                  "color": "green"
                },
                "1": {
                  "text": "RESTORING",
                  "color": "orange"
                },
                "2": {
                  "text": "RECOVERING",
                  "color": "orange"
                },
                "3": {
                  "text": "RECOVERY_PENDING",
                  "color": "red"
                },
                "4": {
                  "text": "SUSPECT",
                  "color": "red"
                },
                "5": {
                  "text": "EMERGENCY",
                  "color": "red"
                },
                "6": {
                  "text": "OFFLINE",
                  "color": "gray"
                },
                "7": {
                  "text": "COPYING",
                  "color": "orange"
                },
                "10": {
                  "text": "OFFLINE_SECONDARY",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Database size",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "data_eyes_database_size_bytes{sql_instance=~\"${sql_instance:regex}\",environment=~\"${environment:regex}\",database=~\"${database:regex}\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "{{sql_instance}} {{category}} {{check}} {{file}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
    }
  ],
  "links": [
    {
      "title": "Fleet",
      "type": "link",
      "url": "/d/data-eyes-fleet",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Instance",
      "type": "link",
      "url": "/d/data-eyes-instance",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Database",
      "type": "link",
      "url": "/d/data-eyes-database",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Health",
      "type": "link",
      "url": "/d/data-eyes-health",
      "keepTime": true,
      "includeVars": true
    }
  ]
}