# =============================================================================
# Data Eyes MCP Server - Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment.
# NEVER commit .env with real credentials to version control.

# Shared fleet configuration (preferred). Docker Compose overrides the path to
# /app/instances.yaml. DEFAULT_INSTANCE is optional; when empty, the first YAML
# entry is used.
INSTANCES_FILE=../instances.yaml
DEFAULT_INSTANCE=
DEFAULT_PRINCIPAL=development-agent
DEPLOYMENT_ENVIRONMENT=development
INSTANCE_ALLOWLIST=dev

# Separate credential pool selected by each instance's credential_env_prefix.
# Provision these as narrowly scoped SQL logins; they override UID/PWD in YAML.
DEV_MSSQL_USER=
DEV_MSSQL_PASSWORD=
STAGING_MSSQL_USER=
STAGING_MSSQL_PASSWORD=
PROD_MSSQL_USER=
PROD_MSSQL_PASSWORD=

# Optional single-instance fallback for standalone MCP use.
MSSQL_CONNECTION_STRING=

# Connection settings
MSSQL_CONNECTION_TIMEOUT=30
MSSQL_QUERY_TIMEOUT=30
MSSQL_MAX_POOL_SIZE=10

# Dashboard repository trend tools (optional) — read-only access to the Data
# Eyes dashboard's own trend-history Postgres database (never a monitored
# SQL Server; see ../repository/init.sql)
REPOSITORY_DSN=

# Network / DNS Rebinding Protection (HTTP transport)
ALLOWED_HOST=

# Security & Safety
READ_ONLY=true
ENABLE_WRITES=false
# ADMIN_CONFIRM=your-secret-token  # Required if ENABLE_WRITES=true

MAX_ROWS_PER_QUERY=50000
MAX_QUERY_LENGTH=50000
MAX_RESPONSE_BYTES=2000000
MAX_CELL_LENGTH=4000
MAX_CONCURRENT_QUERIES=8
SECURITY_ENFORCEMENT=true
ALLOW_REQUEST_CREDENTIALS=false
REQUIRE_SCOPED_CREDENTIALS=true
DISABLE_ADHOC_ENVIRONMENTS=production,staging

# Logging & Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_METRICS=true
ENABLE_PROMETHEUS=true
# SENTRY_DSN=https://xxx@sentry.io/xxx

# Rate Limiting (optional)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_QUERIES_PER_MINUTE=60
