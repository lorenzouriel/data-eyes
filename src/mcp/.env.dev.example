# Copy to .env.dev. This file is mounted only into data-eyes-mcp-dev.
DEV_MSSQL_USER=data_eyes_mcp_dev
DEV_MSSQL_PASSWORD=replace-with-a-generated-secret

# HTTP fails closed until configured. Map each principal to SHA-256 of its
# own random bearer token. Never put the raw token in instances.yaml.
HTTP_TOKEN_HASHES={}
