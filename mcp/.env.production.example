# Copy to .env.production. This file is mounted only into data-eyes-mcp-prod.
PROD_MSSQL_USER=data_eyes_mcp_prod
PROD_MSSQL_PASSWORD=replace-with-a-generated-secret

# HTTP fails closed until configured. Map each principal to SHA-256 of its
# own random bearer token. Never put the raw token in instances.yaml.
HTTP_TOKEN_HASHES={}
