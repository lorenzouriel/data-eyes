# Copy to .env.staging. This file is mounted only into data-eyes-mcp-staging.
STAGING_MSSQL_USER=data_eyes_mcp_staging
STAGING_MSSQL_PASSWORD=replace-with-a-generated-secret

# HTTP fails closed until configured. Map each principal to SHA-256 of its
# own random bearer token. Never put the raw token in instances.yaml.
HTTP_TOKEN_HASHES={}
