# =============================================================================
# Data Eyes MCP Server - environment configuration
# =============================================================================
# Copy to .env and fill in locally. Never commit real credentials.

# Shared fleet file. Relative paths resolve from the mcp/ directory; Docker
# Compose sets /app/instances.yaml. DEFAULT_INSTANCE is optional when the
# deployment has exactly one instance.
INSTANCES_FILE=../instances.yaml
DEFAULT_INSTANCE=
DEFAULT_DATABASE=
DEPLOYMENT_ENVIRONMENT=development
INSTANCE_ALLOWLIST=dev

# SQL login per instance, selected by each instance's credential_env_prefix.
# These replace any UID/PWD in instances.yaml, and the login's own grants decide
# what the MCP can read. Set <PREFIX>_MSSQL_TRUSTED_CONNECTION=yes for Windows auth.
DEV_MSSQL_USER=
DEV_MSSQL_PASSWORD=
STAGING_MSSQL_USER=
STAGING_MSSQL_PASSWORD=
PROD_MSSQL_USER=
PROD_MSSQL_PASSWORD=

# Identity. stdio uses DEFAULT_PRINCIPAL; HTTP maps each principal to the
# SHA-256 hex digest of its own random bearer token and fails closed without it.
DEFAULT_PRINCIPAL=development-agent
HTTP_TOKEN_HASHES={}
# External hostname (no port) accepted by HTTP DNS-rebinding protection.
ALLOWED_HOST=

# Optional 30-day severity history.
PROMETHEUS_URL=http://prometheus:9090

# Limits
MSSQL_CONNECTION_TIMEOUT=30
MSSQL_QUERY_TIMEOUT=30
MAX_ROWS_PER_QUERY=50000
MAX_RESPONSE_BYTES=2000000
MAX_CELL_LENGTH=4000
MAX_CONCURRENT_QUERIES=8
# Tool calls per principal per minute; 0 disables.
RATE_LIMIT_PER_MINUTE=60
# Session tag (APP_NAME()); an APP= in the connection string wins.
MSSQL_APPLICATION_NAME=Data Eyes MCP

LOG_LEVEL=INFO
LOG_FORMAT=json
