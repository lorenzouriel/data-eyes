{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Fleet-wide view of every monitored SQL Server instance. Each instance is validated for Availability Group membership, replica role (PRIMARY/SECONDARY), synchronization health, and whether it is a readable secondary (read replica). See monitor/docs/availability_groups.md.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Fleet Overview — Availability Group & Replica Status",
      "type": "row"
    },
    {
      "datasource": {
        "type": "mssql",
        "uid": "${instance}"
      },
      "description": "Instance identity, current AG role, uptime and active sessions. Color: PRIMARY = green, SECONDARY = blue, STANDALONE = gray.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "replica_role"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "PRIMARY": {
                        "color": "green",
                        "index": 0
                      },
                      "SECONDARY": {
                        "color": "blue",
                        "index": 1
                      },
                      "STANDALONE": {
                        "color": "gray",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": true
        },
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "pluginVersion": "12.2.0",
      "repeat": "instance",
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "${instance}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    CAST(SERVERPROPERTY('ServerName') AS varchar(128)) AS instance,\n    ISNULL(ars.role_desc, 'STANDALONE') AS replica_role,\n    DATEDIFF(MINUTE, si.sqlserver_start_time, GETDATE()) AS uptime_min,\n    (SELECT COUNT(*) FROM sys.dm_exec_sessions WHERE is_user_process = 1) AS active_sessions\nFROM sys.dm_os_sys_info si\nLEFT JOIN sys.dm_hadr_availability_replica_states ars ON ars.is_local = 1;",
          "refId": "A"
        }
      ],
      "title": "Instance Health",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "mssql",
        "uid": "${instance}"
      },
      "description": "AG membership and replica role for this instance. is_read_replica = YES only when this instance is a SECONDARY with read-only (or ALL) connections allowed — that is the actual read replica.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "is_read_replica"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "YES": {
                        "color": "blue",
                        "index": 0
                      },
                      "NO": {
                        "color": "gray",
                        "index": 1
                      },
                      "N/A": {
                        "color": "text",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sync_health"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "HEALTHY": {
                        "color": "green",
                        "index": 0
                      },
                      "NOT_HEALTHY": {
                        "color": "red",
                        "index": 1
                      },
                      "N/A": {
                        "color": "text",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 3,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "pluginVersion": "12.2.0",
      "repeat": "instance",
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "${instance}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    CAST(SERVERPROPERTY('ServerName') AS varchar(128)) AS instance,\n    CASE WHEN CAST(SERVERPROPERTY('IsHadrEnabled') AS int) = 1 THEN 'Yes' ELSE 'No' END AS hadr_enabled,\n    ISNULL(ag.name, 'N/A') AS availability_group,\n    ISNULL(ars.role_desc, 'STANDALONE') AS replica_role,\n    ISNULL(ars.synchronization_health_desc, 'N/A') AS sync_health,\n    ISNULL(ar.secondary_role_allow_connections_desc, 'N/A') AS read_replica_allowed,\n    CASE\n        WHEN ars.role_desc = 'SECONDARY' AND ar.secondary_role_allow_connections_desc IN ('READ_ONLY', 'ALL') THEN 'YES'\n        WHEN ars.role_desc = 'SECONDARY' THEN 'NO'\n        ELSE 'N/A'\n    END AS is_read_replica\nFROM (SELECT 1 AS dummy) d\nLEFT JOIN sys.dm_hadr_availability_replica_states ars ON ars.is_local = 1\nLEFT JOIN sys.availability_replicas ar ON ar.replica_id = ars.replica_id\nLEFT JOIN sys.availability_groups ag ON ag.group_id = ar.group_id;",
          "refId": "A"
        }
      ],
      "title": "AG & Replica Detail",
      "type": "table"
    },
    {
      "datasource": {
        "type": "mssql",
        "uid": "${instance}"
      },
      "description": "Per-database synchronization state for this instance's AG replica. Empty on standalone instances (no AG configured) — that itself confirms the instance is not part of any Availability Group.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sync_health"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "HEALTHY": {
                        "color": "green",
                        "index": 0
                      },
                      "NOT_HEALTHY": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "pluginVersion": "12.2.0",
      "repeat": "instance",
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "${instance}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    DB_NAME(drs.database_id) AS database_name,\n    ar.replica_server_name AS replica,\n    drs.synchronization_state_desc AS sync_state,\n    drs.synchronization_health_desc AS sync_health,\n    drs.is_primary_replica,\n    drs.log_send_queue_size AS log_send_queue_kb,\n    drs.redo_queue_size AS redo_queue_kb\nFROM sys.dm_hadr_database_replica_states drs\nJOIN sys.availability_replicas ar ON ar.replica_id = drs.replica_id\nWHERE drs.is_local = 1\nORDER BY database_name;",
          "refId": "A"
        }
      ],
      "title": "Per-Database Sync State (AG members)",
      "type": "table"
    }
  ],
  "preload": false,
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": [
    "data-eyes",
    "fleet",
    "availability-group"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": true,
        "label": "Instance",
        "multi": true,
        "name": "instance",
        "options": [],
        "query": "mssql",
        "refresh": 1,
        "regex": "/^SQL Server - .*/",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Fleet Overview - All Instances",
  "uid": "fleet-overview",
  "version": 1
}
