# =============================================================================
# Data Eyes Dashboard Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment.
# NEVER commit .env with real credentials to version control.

# -----------------------------------------------------------------------------
# Auth (REQUIRED) — a single shared admin credential, see app/auth.py
# -----------------------------------------------------------------------------
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=change-me

# Signs the session cookie — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=change-me-to-a-long-random-string
SESSION_MAX_AGE_SECONDS=43200

# -----------------------------------------------------------------------------
# Fleet registry
# -----------------------------------------------------------------------------
INSTANCES_FILE=instances.yaml

# -----------------------------------------------------------------------------
# MCP client
# -----------------------------------------------------------------------------
MCP_CALL_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# CORS (only needed for local dev when the frontend runs on a different
# origin, e.g. the Vite dev server). JSON array string. Leave empty in
# production if the frontend is served same-origin (behind a reverse proxy).
# -----------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# -----------------------------------------------------------------------------
# Trend-history repository (dedicated DB — never a monitored SQL Server, see
# dashboard/repository/init.sql). Optional: leave unset to run without trend
# history, exactly like Phase 2/3 — the collector simply doesn't start.
# Via docker-compose (dashboard-repo service):
#   REPOSITORY_DSN=postgresql://data_eyes:change-me@dashboard-repo:5432/data_eyes_dashboard
# Local dev against a standalone Postgres:
#   REPOSITORY_DSN=postgresql://data_eyes:change-me@localhost:5432/data_eyes_dashboard
# -----------------------------------------------------------------------------
REPOSITORY_DSN=
COLLECTOR_INTERVAL_SECONDS=60
TREND_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Embedded insights agent (app/insights_agent.py, app/insights_sweep.py).
# Optional: leave unset to run without it — every insight endpoint degrades
# to "no insight" instead of erroring, and the background sweep never starts.
# Model tiering (fast/cheap for routine, stronger for on-demand) is fixed in
# code, not configurable here — see insights_agent.py.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
INSIGHTS_SWEEP_INTERVAL_SECONDS=600
INSIGHTS_FEED_MAX_SIZE=50

HOST=0.0.0.0
PORT=8090
