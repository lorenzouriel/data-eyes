# =============================================================================
# Data Eyes Dashboard Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment.
# NEVER commit .env with real credentials to version control.

# -----------------------------------------------------------------------------
# Auth (REQUIRED) — a single shared admin credential, see app/auth.py
# -----------------------------------------------------------------------------
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=change-me

# Signs the session cookie — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=change-me-to-a-long-random-string
SESSION_MAX_AGE_SECONDS=43200

# -----------------------------------------------------------------------------
# Fleet registry
# -----------------------------------------------------------------------------
INSTANCES_FILE=instances.yaml

# -----------------------------------------------------------------------------
# MCP client
# -----------------------------------------------------------------------------
MCP_CALL_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# CORS (only needed for local dev when the frontend runs on a different
# origin, e.g. the Vite dev server). JSON array string. Leave empty in
# production if the frontend is served same-origin (behind a reverse proxy).
# -----------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

HOST=0.0.0.0
PORT=8090
