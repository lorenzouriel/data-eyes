# =============================================================================
# Data Eyes — settings for every service except the fleet
# =============================================================================

# Grafana — the UI and alerting (http://<GRAFANA_BIND_IP>:3000)
GRAFANA_BIND_IP=127.0.0.1
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# Alert emails. Leave SMTP empty to keep alerts in the Grafana UI only.
GRAFANA_NOTIFICATION_ADDRESSES=
GRAFANA_SMTP_HOST=
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM_ADDRESS=
GRAFANA_SMTP_FROM_NAME=Data Eyes

# "Ask the fleet" agent (optional, internal only)
AI_PROVIDER=anthropic
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
LOCAL_AI_BASE_URL=
AGENT_MCP_TOKEN=
